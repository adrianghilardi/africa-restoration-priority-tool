title: "Restoration Priority Tool for Congo Basin and KAZA"
version: "1.0.0"
date-released: "2026-09-23"
authors:
  - family-names: "Ghilardi"
    given-names: "Adrian"
    orcid: "https://orcid.org/0000-0002-7286-0670"
